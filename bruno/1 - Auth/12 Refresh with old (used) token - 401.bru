meta {
  name: Refresh with old (used) token - 401
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/auth/refresh
  body: json
  auth: none
}

body:json {
  {
    "refreshToken": "{{usedRefreshToken}}"
  }
}

tests {
  test("status is 401", function () {
    expect(res.status).to.equal(401);
  });
}
