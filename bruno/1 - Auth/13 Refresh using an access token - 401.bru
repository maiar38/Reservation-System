meta {
  name: Refresh using an access token - 401
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/auth/refresh
  body: json
  auth: none
}

body:json {
  {
    "refreshToken": "{{customerAToken}}"
  }
}

tests {
  test("status is 401", function () {
    expect(res.status).to.equal(401);
  });
}
