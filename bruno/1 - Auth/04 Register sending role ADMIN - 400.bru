meta {
  name: Register sending role ADMIN - 400
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Sneaky User",
    "email": "sneaky@example.com",
    "password": "Passw0rd123",
    "role": "ADMIN"
  }
}

tests {
  test("status is 400", function () {
    expect(res.status).to.equal(400);
  });

  test("message mentions "role should not exist"", function () {
    expect(JSON.stringify(res.body.message)).to.include('role should not exist');
  });
}
