meta {
  name: Register Customer A
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Customer A",
    "email": "{{customerAEmail}}",
    "password": "{{customerPassword}}"
  }
}

tests {
  test("status is 201 or 409", function () {
    expect([201, 409]).to.include(res.status);
  });

  test("new user is a CUSTOMER without password (on first run)", function () {
    if (res.status === 201) {
      expect(res.body.role).to.equal('CUSTOMER');
      expect(res.body).to.not.have.property('password');
    }
  });
}
