meta {
  name: Refresh Customer A
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/auth/refresh
  body: json
  auth: none
}

body:json {
  {
    "refreshToken": "{{customerARefreshToken}}"
  }
}

script:pre-request {
  // remember the token we are about to use, for the next test
  bru.setEnvVar("usedRefreshToken", bru.getEnvVar("customerARefreshToken"));
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("customerAToken", res.body.accessToken);
    bru.setEnvVar("customerARefreshToken", res.body.refreshToken);
  }
}

tests {
  test("status is 200", function () {
    expect(res.status).to.equal(200);
  });

  test("returns an access token and a refresh token", function () {
    expect(res.body.accessToken).to.be.a('string');
    expect(res.body.refreshToken).to.be.a('string');
  });

  test("gives a NEW refresh token", function () {
    expect(res.body.refreshToken).to.not.equal(bru.getEnvVar('usedRefreshToken'));
  });
}
