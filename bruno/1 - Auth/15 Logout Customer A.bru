meta {
  name: Logout Customer A
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/auth/logout
  body: none
  auth: bearer
}

auth:bearer {
  token: {{customerAToken}}
}

script:pre-request {
  bru.setEnvVar("loggedOutRefreshToken", bru.getEnvVar("customerARefreshToken"));
}

tests {
  test("status is 204", function () {
    expect(res.status).to.equal(204);
  });
}
