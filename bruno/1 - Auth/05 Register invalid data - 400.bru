meta {
  name: Register invalid data - 400
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "X",
    "email": "abc",
    "password": "123"
  }
}

tests {
  test("status is 400", function () {
    expect(res.status).to.equal(400);
  });

  test("returns one message per broken rule", function () {
    expect(res.body.message).to.be.an('array');
    expect(res.body.message.length).to.be.greaterThan(2);
  });
}
