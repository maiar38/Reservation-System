meta {
  name: Register duplicate email with capitals - 409
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Customer A Again",
    "email": "CUSTOMER.A@example.com",
    "password": "Passw0rd123"
  }
}

tests {
  test("status is 409", function () {
    expect(res.status).to.equal(409);
  });

  test("message mentions "already exists"", function () {
    expect(JSON.stringify(res.body.message)).to.include('already exists');
  });

  test("error has the standard shape", function () {
    expect(res.body).to.have.all.keys('statusCode', 'message', 'path', 'timestamp');
  });
}
