meta {
  name: Status with wrong type - 400
  type: http
  seq: 26
}

patch {
  url: {{baseUrl}}/users/{{customerBId}}/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "isActive": "no"
  }
}

tests {
  test("status is 400", function () {
    expect(res.status).to.equal(400);
  });
}
