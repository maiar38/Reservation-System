meta {
  name: Update my profile name too short - 400
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/users/me
  body: json
  auth: bearer
}

auth:bearer {
  token: {{customerAToken}}
}

body:json {
  {
    "name": "A"
  }
}

tests {
  test("status is 400", function () {
    expect(res.status).to.equal(400);
  });
}
