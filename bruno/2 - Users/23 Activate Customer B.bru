meta {
  name: Activate Customer B
  type: http
  seq: 23
}

patch {
  url: {{baseUrl}}/users/{{customerBId}}/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "isActive": true
  }
}

tests {
  test("status is 200", function () {
    expect(res.status).to.equal(200);
  });

  test("is active again", function () {
    expect(res.body.isActive).to.equal(true);
  });
}
