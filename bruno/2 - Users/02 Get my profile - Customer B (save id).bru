meta {
  name: Get my profile - Customer B (save id)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/users/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{customerBToken}}
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("customerBId", res.body._id);
  }
}

tests {
  test("status is 200", function () {
    expect(res.status).to.equal(200);
  });
}
