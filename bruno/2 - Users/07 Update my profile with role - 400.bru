meta {
  name: Update my profile with role - 400
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/users/me
  body: json
  auth: bearer
}

auth:bearer {
  token: {{customerAToken}}
}

body:json {
  {
    "role": "ADMIN"
  }
}

tests {
  test("status is 400", function () {
    expect(res.status).to.equal(400);
  });

  test("message mentions "role should not exist"", function () {
    expect(JSON.stringify(res.body.message)).to.include('role should not exist');
  });
}
