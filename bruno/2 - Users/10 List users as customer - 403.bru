meta {
  name: List users as customer - 403
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/users
  body: none
  auth: bearer
}

auth:bearer {
  token: {{customerAToken}}
}

tests {
  test("status is 403", function () {
    expect(res.status).to.equal(403);
  });

  test("error has the standard shape", function () {
    expect(res.body).to.have.all.keys('statusCode', 'message', 'path', 'timestamp');
  });
}
