meta {
  name: Search users
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/users?search=customer
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("status is 200", function () {
    expect(res.status).to.equal(200);
  });

  test("finds at least the 2 customers", function () {
    expect(res.body.meta.total).to.be.at.least(2);
  });
}
