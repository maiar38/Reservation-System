meta {
  name: Search users with regex characters
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/users?search=.*
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("status is 200", function () {
    expect(res.status).to.equal(200);
  });

  test("treated as normal text, so nothing matches", function () {
    expect(res.body.meta.total).to.equal(0);
  });
}
