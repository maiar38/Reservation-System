meta {
  name: Login wrong password - 401
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{customerEmail}}",
    "password": "WrongPassword123"
  }
}

tests {
  test("status is 401", () => expect(res.status).to.equal(401));
}
