meta {
  name: Register with role - 400
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Sneaky User",
    "email": "sneaky@example.com",
    "password": "{{customerPassword}}",
    "role": "ADMIN"
  }
}

tests {
  test("status is 400", () => expect(res.status).to.equal(400));
}
