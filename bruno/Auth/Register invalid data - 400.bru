meta {
  name: Register invalid data - 400
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "A",
    "email": "not-an-email",
    "password": "short"
  }
}

tests {
  test("status is 400", () => expect(res.status).to.equal(400));
  test("returns all validation errors", () => expect(res.body.message).to.have.lengthOf(3));
}
