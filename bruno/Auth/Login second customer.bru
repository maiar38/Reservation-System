meta {
  name: Login second customer
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{secondCustomerEmail}}",
    "password": "{{customerPassword}}"
  }
}

script:post-response {
  bru.setVar("secondCustomerToken", res.body.accessToken);
  bru.setVar("secondCustomerRefreshToken", res.body.refreshToken);
}

tests {
  test("status is 200", () => expect(res.status).to.equal(200));
  test("returns both tokens", () => {
    expect(res.body.accessToken).to.be.a("string");
    expect(res.body.refreshToken).to.be.a("string");
  });
}
