meta {
  name: Get deleted resource as admin
  type: http
  seq: 17
}

get {
  url: {{baseUrl}}/resources/{{resourceId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("status is 200", () => expect(res.status).to.equal(200));
  test("resource is inactive", () => expect(res.body.isActive).to.equal(false));
}
