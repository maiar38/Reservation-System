meta {
  name: Create with closeTime before openTime - 400
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/resources
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "name": "Backwards Room",
    "description": "Small room with a TV",
    "type": "MEETING_ROOM",
    "capacity": 8,
    "operatingHours": {
      "openTime": "18:00",
      "closeTime": "08:00"
    }
  }
}

tests {
  test("status is 400", function () {
    expect(res.status).to.equal(400);
  });

  test("message mentions "closeTime must be later than openTime"", function () {
    expect(JSON.stringify(res.body.message)).to.include('closeTime must be later than openTime');
  });
}
