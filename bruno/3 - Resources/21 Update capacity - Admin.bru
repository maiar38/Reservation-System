meta {
  name: Update capacity - Admin
  type: http
  seq: 21
}

patch {
  url: {{baseUrl}}/resources/{{resourceId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "capacity": 10
  }
}

tests {
  test("status is 200", function () {
    expect(res.status).to.equal(200);
  });

  test("capacity changed and hours kept", function () {
    expect(res.body.capacity).to.equal(10);
    expect(res.body.operatingHours.openTime).to.equal('08:00');
    expect(res.body.operatingHours.closeTime).to.equal('18:00');
  });
}
