meta {
  name: Create second resource - Admin
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/resources
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "name": "{{resource2Name}}",
    "description": "Small room with a TV",
    "type": "CONFERENCE_ROOM",
    "capacity": 20,
    "operatingHours": {
      "openTime": "08:00",
      "closeTime": "18:00"
    }
  }
}

script:pre-request {
  bru.setEnvVar("resource2Name", "Pyramids Conference Room " + Date.now());
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("resource2Id", res.body._id);
  }
}

tests {
  test("status is 201", function () {
    expect(res.status).to.equal(201);
  });
}
