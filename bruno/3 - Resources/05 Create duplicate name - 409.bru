meta {
  name: Create duplicate name - 409
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/resources
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "name": "{{resourceName}}",
    "description": "Small room with a TV",
    "type": "MEETING_ROOM",
    "capacity": 8,
    "operatingHours": {
      "openTime": "08:00",
      "closeTime": "18:00"
    }
  }
}

tests {
  test("status is 409", function () {
    expect(res.status).to.equal(409);
  });

  test("message mentions "already exists"", function () {
    expect(JSON.stringify(res.body.message)).to.include('already exists');
  });
}
